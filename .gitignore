# =========================================================================
# 基金账目管理系统 - Git 忽略规则配置 (.gitignore)
# =========================================================================

# --- 依赖库 (Dependencies) ---
node_modules/
jspm_packages/
web_modules/

# --- 本地动态数据与备份 (Local Data & Backups) ---
# 忽略自动生成的数据库备份目录
backups/
# 忽略打包归档的旧版本 zip 压缩包
a_归档/
*.zip
*.tar.gz
*.rar
*.7z

# 忽略全部本地运行数据与配置（避免提交测试数据、隐私账目或敏感配置），但保留目录结构
data/*
!data/.gitkeep

# --- 日志与调试文件 (Logs & Diagnostics) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- 运行时与进程管理 (Runtime & Process) ---
pids
*.pid
*.seed
*.pid.lock

# --- 测试与覆盖率 (Test & Coverage) ---
coverage/
*.lcov
.nyc_output/

# --- 编译器/构建缓存与输出 (Build & Cache) ---
.npm
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.tsbuildinfo
build/
dist/
dist-demo/
out/

# --- 环境配置文件 (Sensitive Environment Variables) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- 本地 Codex / Agent 配置 (Local AI Tooling) ---
.agents/
.codex/

# --- 常见 IDE / 编辑器配置 (Editor & IDE) ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# --- 操作系统临时文件 (OS Metadata) ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
